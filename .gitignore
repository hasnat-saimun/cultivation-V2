# Laravel environment files
.env
.env.*
!.env.example

# Composer dependencies
/vendor/

# Node dependencies
/node_modules/

# Vite / frontend build
/public/build/
/public/hot

# Laravel public storage symlink
/public/storage
/public/upload/

# Laravel storage runtime files
/storage/*.key
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*

# Keep required storage directories
!/storage/logs/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/framework/testing/.gitignore

# PHPUnit
.phpunit.result.cache
.phpunit.cache/
phpunit.xml.bak

# Temporary / QA files
/tmp/
*.tmp
*.temp

# IDE / Editor
/.idea/
/.vscode/
*.code-workspace

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel auth files
/.auth.json

# Homestead
Homestead.json
Homestead.yaml

# PHPStorm
.phpstorm.meta.php

# Backup files
*.bak
*.backup
*.old
*.orig
*~

# Database dumps / backups
*.sql
*.sql.gz
*.dump

# Local certificates / secrets
*.pem
*.key
*.crt

# Misc local files
/.fleet/
/.zed/